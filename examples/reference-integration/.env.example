# Base URL of the soroverify-verifier deployment the badge looks up.
# NEXT_PUBLIC_ vars are inlined into the browser bundle by Next.js at build
# time. Leave unset to default to the local verifier (http://localhost:8080),
# which is where the reference integration is expected to point during the RFP
# demo. Copy to .env.local and change only if you run the verifier elsewhere.
NEXT_PUBLIC_SOROVERIFY_API_URL=http://localhost:8080
