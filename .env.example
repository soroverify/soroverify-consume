# Environment variables read by soroverify-consume.
# Copy to wherever your process reads env from (shell, .env, etc.) and adjust.

# Base URL of a soroverify-verifier deployment.
# Read by @soroverify/sdk's apiBaseUrlFromEnv() in Node/bundler contexts.
# In the browser, the widget takes the URL from its api-base-url attribute
# instead of this variable.
SOROVERIFY_API_URL=http://localhost:8080

# Base URL of a soroverify-verifier deployment, inlined by Next.js at build
# time. Read by the reference integration (examples/reference-integration).
# Set this in examples/reference-integration/.env.local to point the example
# at a different verifier deployment.
NEXT_PUBLIC_SOROVERIFY_API_URL=http://localhost:8080

# Note: the original env spec also listed SOROBAN_RPC_URL and
# NETWORK_PASSPHRASE for client-side contract resolution. Nothing in this repo
# reads them anymore — resolution moved server-side to the verifier's
# GET /verifications/by-contract/:contractId endpoint. Do not set them.
